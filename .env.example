# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_strong_random_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_spreadsheet_id_here

# Tab GIDs: open the sheet tab, look at the URL: ...#gid=<number>
SURVEYS_GID=0
HVAC_UNITS_GID=123456789

# ── Google Drive ──────────────────────────────────────────────────────────────
# The folder ID for "Bell Preventive Maintenance" (open folder in Drive, copy ID from URL)
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# ── Service Account ───────────────────────────────────────────────────────────
# Option A: paste the entire JSON as a single line (best for Cloud Run secrets)
SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# Option B: path to the JSON key file (for local dev / Docker volume mount)
# SERVICE_ACCOUNT_FILE=/app/service_account.json

# ── AppSheet write-back (optional) ────────────────────────────────────────────
# Writes the uploaded PDF's Drive URL back into the survey row in AppSheet.
# Find App ID in AppSheet Editor → Info → Properties.
APPSHEET_APP_ID=your_appsheet_app_id
# Generate from AppSheet Editor → Manage → Integrations → Enable API
APPSHEET_API_KEY=your_appsheet_api_key
SURVEYS_TABLE_NAME=Surveys
PDF_URL_COLUMN=PDF Report URL
